POSTGRES_USER=discord
POSTGRES_PASSWORD=discord
POSTGRES_DB=discord_analytics
POSTGRES_PORT=5432
API_PORT=8000
FRONTEND_PORT=3000
AGENT_DB_USER=discord_agent
AGENT_DB_PASSWORD=discord_agent

# The hostname your browser will actually use to reach these containers.
# Leave as localhost if you're opening the frontend on the same machine
# Docker is running on. If Docker is on a remote machine (a server you're
# SSH'd into, a Tailscale box, etc.) and you're opening the frontend from
# your own machine's browser, set this to that machine's address (e.g. a
# Tailscale IP) -- it's used both to build the frontend's API_BASE_URL and
# the API's CORS allow-list (FRONTEND_ORIGIN), so the two stay in sync from
# one value instead of needing separate overrides.
PUBLIC_HOST=localhost

# LLM provider: "openai" or "anthropic". Only the selected one's key is
# required -- the app fails loudly at startup if it's missing, not the
# other one.
LLM_PROVIDER=openai

# OpenAI: get a key at https://platform.openai.com/api-keys (a ChatGPT
# Plus/Pro subscription does NOT include API access -- separate product,
# separate billing).
OPENAI_API_KEY=

# Anthropic: get a key at https://console.anthropic.com/settings/keys (same
# caveat -- a Claude Pro subscription does NOT include API access).
ANTHROPIC_API_KEY=

# Default matches LLM_PROVIDER=openai above. Switching provider almost
# always means changing this too (e.g. claude-3-5-sonnet-20241022 for
# anthropic) -- there's no per-provider default, this is the one in effect.
AGENT_MODEL=gpt-4.1

# Bounded retries: attempts after the first before the agent gives up on a
# failing tool call and surrenders gracefully instead of looping forever.
AGENT_MAX_TOOL_RETRIES=1

# Row cap for any SQL the agent executes (live chat and pin refresh alike),
# enforced by rewriting the query's own LIMIT clause before it runs -- see
# api/app/agent/sql_safety.py
AGENT_ROW_CAP=1000
# statement_timeout (ms) for the agent's DB connection pool.
AGENT_QUERY_TIMEOUT_MS=5000

# How many candidate ids (most recent first) the loop actively suggests to
# a consuming plugin (chart, image_chart, ...) at once. Older ids beyond
# this are still valid if referenced explicitly -- this only bounds how
# many get proactively hinted, so a long session's hint text doesn't grow
# without bound.
AGENT_CONSUMES_HINT_LIMIT=5

# API's own (non-agent) Postgres connection pool -- servers/channels/
# members/activity/pins endpoints, all fixed parameterized queries.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_STATEMENT_TIMEOUT_MS=5000

# Agent's own connection pool -- separate from the API's above since the
# agent's connections run untrusted LLM-generated SQL (see AGENT_DB_USER),
# not just the API's own fixed queries.
AGENT_DB_POOL_MIN_SIZE=1
AGENT_DB_POOL_MAX_SIZE=10

# Structured JSON logs to stdout (docker compose logs api). DEBUG for
# maximum step-by-step visibility while debugging routing/chaining issues.
LOG_LEVEL=INFO
